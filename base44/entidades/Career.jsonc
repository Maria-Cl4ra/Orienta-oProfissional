{
  "name": "Career",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "T\u00edtulo da Profiss\u00e3o"
    },
    "area": {
      "type": "string",
      "title": "\u00c1rea",
      "enum": [
        "Exatas",
        "Humanas",
        "Biol\u00f3gicas",
        "Artes",
        "Desenvolvimento de Sistemas",
        "M\u00fasica"
      ]
    },
    "subarea": {
      "type": "string",
      "title": "Sub\u00e1rea"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "average_salary": {
      "type": "string",
      "title": "Sal\u00e1rio M\u00e9dio"
    },
    "salary_range": {
      "type": "string",
      "title": "Faixa Salarial"
    },
    "education_time": {
      "type": "string",
      "title": "Tempo de Forma\u00e7\u00e3o"
    },
    "education_level": {
      "type": "string",
      "title": "N\u00edvel de Forma\u00e7\u00e3o",
      "enum": [
        "T\u00e9cnico",
        "Superior",
        "Tecn\u00f3logo"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Habilidades Necess\u00e1rias"
    },
    "market": {
      "type": "string",
      "title": "Mercado de Trabalho"
    },
    "growth_trend": {
      "type": "string",
      "title": "Tend\u00eancia de Crescimento",
      "enum": [
        "Crescente",
        "Est\u00e1vel",
        "Declinante"
      ]
    },
    "entry_difficulty": {
      "type": "string",
      "title": "Dificuldade de Ingresso",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta"
      ]
    },
    "remote_possible": {
      "type": "boolean",
      "title": "Trabalho Remoto Poss\u00edvel",
      "default": false
    },
    "international_possible": {
      "type": "boolean",
      "title": "Atua\u00e7\u00e3o Internacional",
      "default": false
    },
    "routine": {
      "type": "string",
      "title": "Rotina Profissional"
    },
    "image_url": {
      "type": "string",
      "title": "URL da Imagem"
    },
    "icon": {
      "type": "string",
      "title": "\u00cdcone (lucide)"
    }
  },
  "required": [
    "title",
    "area",
    "description"
  ]
}